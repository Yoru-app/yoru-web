# /etc/yoru-web-v3.env — права 600, владелец root
# Адрес, по которому открывается сайт (без слеша в конце)
PUBLIC_URL=https://anime.example.com
# Сервер слушает только локально, наружу его выпускает прокси (Caddy)
HOST=127.0.0.1
PORT=5366
# Вход в панель администратора (PUBLIC_URL/admin_panel). Если не задать —
# логин и пароль создаются при первом запуске по коду из журнала.
#YORU_ADMIN_LOGIN=admin
#YORU_ADMIN_PASSWORD=длинный-пароль
# Необязательно: приложение Shikimori здесь, а не в панели администратора
#SHIKIMORI_CLIENT_ID=
#SHIKIMORI_CLIENT_SECRET=
#SHIKIMORI_APP_NAME=Yoru
# Необязательно: ключ TMDB (баннеры «как на AniScroll», логотипы в плеере)
#TMDB_API_KEY=
# Необязательно: зеркало Anime365, если .org недоступен из страны VPS
#ANIME365_SITE=https://smotret-anime.org
